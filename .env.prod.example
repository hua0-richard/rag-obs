# Copy to .env.prod and fill in. Used with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Tailscale reusable or ephemeral auth key (Admin Console > Settings > Keys).
# Tag it (e.g. tag:rag-obs) if your tailnet ACLs require tagged keys for Funnel.
TS_AUTHKEY=

# Postgres+pgvector runs locally as the `db` service (see docker-compose.prod.yml).
# POSTGRES_DB and POSTGRES_USER have defaults (ragobs / raguser) — only the
# password is required. Pick something you don't use elsewhere; this is what
# guards the DB since it's reachable by anything on the compose network.
POSTGRES_PASSWORD=
# POSTGRES_DB=ragobs
# POSTGRES_USER=raguser

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# URL of wherever the frontend is actually hosted (e.g. Netlify) — used only
# for CORS. Not related to this node's own Funnel domain.
FRONTEND_URL=
